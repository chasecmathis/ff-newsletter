# ESPN private-league cookies. Log in at fantasy.espn.com, then DevTools >
# Application > Cookies. These expire every few months — when ingest starts
# failing, this is why.
ESPN_LEAGUE_ID=123456
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=AEB...long-url-encoded-value...

# console.anthropic.com -> API keys. Only needed for `ffnews draft` and
# `ffnews verify --deep`.
ANTHROPIC_API_KEY=sk-ant-...
