---
import { teamUrl } from "../lib/url";
import type { Efficiency } from "../lib/schema";

/** The week's worst start/sit calls. The top one gets the penalty flag. */
interface Props { efficiency: Efficiency[]; year: number; limit?: number }
const { efficiency, year, limit = 3 } = Astro.props;
const rows = efficiency.slice(0, limit);
---
<div class="space-y-3">
  {rows.map((row, i) => (
    <div class="rise border hairline bg-paper p-4" style={`--i:${i}`}>
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div class="flex items-center gap-2.5 flex-wrap">
          <a href={teamUrl(year, row.teamId)} class="no-underline font-medium hover:text-field">{row.name}</a>
          {i === 0 && <span class="flag-tag">Flag on the play</span>}
        </div>
        <div class="font-mono text-sm tabular shrink-0">
          <span class="font-semibold">{row.actual.toFixed(1)}</span>
          <span class="text-ink-soft"> / {row.optimal.toFixed(1)}</span>
          <span class="text-field ml-2">{row.efficiencyPct.toFixed(0)}%</span>
        </div>
      </div>
      {row.worstDecision && (
        <p class="mt-2.5 text-[0.9375rem] leading-snug text-ink-soft">
          Started <strong class="text-ink font-medium">{row.worstDecision.startedName}</strong>
          <span class="font-mono text-sm"> ({row.worstDecision.startedPoints.toFixed(1)})</span>
          over <strong class="text-ink font-medium">{row.worstDecision.benchedName}</strong>
          <span class="font-mono text-sm"> ({row.worstDecision.benchedPoints.toFixed(1)})</span>
          at {row.worstDecision.slot}.
        </p>
      )}
      <div class="mt-3 h-1 bg-ink/8 rounded-full overflow-hidden" aria-hidden="true">
        <div class="h-full bg-field/70" style={`width:${Math.min(100, row.efficiencyPct)}%`}></div>
      </div>
    </div>
  ))}
</div>
