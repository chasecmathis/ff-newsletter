---
import { teamUrl } from "../lib/url";
import type { AllPlayRow } from "../lib/schema";

/**
 * All-play replaces a black-box "power score". Every reader understands
 * "56-21 against the whole league"; nobody understands "power score 28.20".
 *
 * Built as a list rather than a table: this lives in a ~20rem rail, and five
 * columns in that width leaves no room for a name like "Never Gonna Gibbs You
 * Up". Two lines per team gives the name a full line and the numbers their own,
 * so nothing has to be truncated or squeezed.
 */
interface Props { rows: AllPlayRow[]; year: number }
const { rows, year } = Astro.props;

// Bars are scaled to the widest swing in the league, so the shape of the
// season is visible rather than every bar being nearly full.
const widest = Math.max(...rows.map((r) => Math.abs(r.luck)), 1);

const entries = rows.map((row) => ({
  ...row,
  unlucky: row.luck < -0.5,
  lucky: row.luck > 0.5,
  // Half-width max so left and right swings share a centre line.
  barPct: (Math.abs(row.luck) / widest) * 50,
}));
---
<ol class="space-y-0">
  {entries.map((row) => (
    <li class="border-b hairline last:border-0 py-3.5 first:pt-0">
      <div class="flex items-baseline gap-3">
        <span class:list={[
          "font-display text-lg leading-none shrink-0 w-6 tabular",
          row.rank === 1 ? "text-field" : "text-ink/25",
        ]}>{String(row.rank).padStart(2, "0")}</span>
        <a
          href={teamUrl(year, row.teamId)}
          class="no-underline font-medium leading-snug hover:text-field min-w-0"
        >{row.name}</a>
      </div>

      <div class="flex items-center justify-between gap-3 mt-2 pl-9">
        <span class="font-mono text-xs tabular text-ink-soft whitespace-nowrap">
          {row.allPlayRecord}
          <span class="text-ink/30 mx-1.5">·</span>
          {(row.allPlayPct * 100).toFixed(0)}%
        </span>
        <span class:list={[
          "font-mono text-xs tabular whitespace-nowrap",
          row.unlucky ? "text-penalty" : row.lucky ? "text-field" : "text-ink-soft",
        ]}>
          {row.luck > 0 ? "+" : ""}{row.luck.toFixed(2)}
        </span>
      </div>

      <!-- Diverging bar. The centre tick is the reference the bar diverges from:
           without it visible, a bar reads as a plain meter instead. -->
      <div class="relative h-1.5 mt-1.5 ml-9 bg-ink/8 rounded-full" aria-hidden="true">
        <span class="absolute -top-1 -bottom-1 left-1/2 w-px bg-ink/35"></span>
        <span
          class:list={[
            "absolute inset-y-0 rounded-full",
            row.luck >= 0 ? "left-1/2 bg-field/80" : "right-1/2 bg-penalty/80",
          ]}
          style={`width:${row.barPct}%`}
        ></span>
      </div>
    </li>
  ))}
</ol>

<p class="mt-4 font-mono text-[0.6875rem] text-ink-soft tracking-wide leading-relaxed">
  All-play is your record if you had played every team every week. The bar shows
  luck: real wins minus what those scores earned. Left of centre means you
  deserved better.
</p>
