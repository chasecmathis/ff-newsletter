---
import { teamUrl } from "../lib/url";
import type { AllPlayRow } from "../lib/schema";

/**
 * All-play replaces a black-box "power score". Every reader understands
 * "47-19 against the whole league"; nobody understands "power score 28.20".
 */
interface Props { rows: AllPlayRow[]; year: number }
const { rows, year } = Astro.props;
const widest = Math.max(...rows.map((r) => Math.abs(r.luck)), 1);
---
<div>
  <table class="w-full border-collapse text-left">
    <thead>
      <tr class="border-b-2 hairline">
        {["", "Team", "All-play", "Win%", "Luck"].map((h, i) => (
          <th class:list={["eyebrow pb-2 font-normal", i === 0 && "w-8", i >= 2 && "text-right", i === 1 && "pl-3", i === 3 && "hidden sm:table-cell"]}>{h}</th>
        ))}
      </tr>
    </thead>
    <tbody class="tabular">
      {rows.map((row) => (
        <tr class="border-b hairline hover:bg-paper-deep/60 transition-colors">
          <td class="py-2.5"><span class="font-display text-lg text-ink/25">{row.rank}</span></td>
          <td class="py-2.5 pl-3">
            <a href={teamUrl(year, row.teamId)} class="no-underline hover:text-flag font-medium text-sm">{row.name}</a>
          </td>
          <td class="py-2.5 text-right font-mono text-sm">{row.allPlayRecord}</td>
          <td class="py-2.5 text-right font-mono text-sm text-ink-soft hidden sm:table-cell">{(row.allPlayPct * 100).toFixed(0)}%</td>
          <td class="py-2.5 text-right">
            <div class="flex items-center justify-end gap-2">
              <span class:list={[
                "font-mono text-sm",
                row.luck > 0.5 ? "text-turf" : row.luck < -0.5 ? "text-flag" : "text-ink-soft",
              ]}>{row.luck > 0 ? "+" : ""}{row.luck.toFixed(1)}</span>
              <span class="hidden sm:block w-14 h-1.5 bg-ink/8 relative rounded-full overflow-hidden" aria-hidden="true">
                <span
                  class:list={["absolute top-0 h-full", row.luck >= 0 ? "bg-turf left-1/2" : "bg-flag right-1/2"]}
                  style={`width:${(Math.abs(row.luck) / widest) * 50}%`}
                ></span>
              </span>
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="mt-3 font-mono text-[0.6875rem] text-ink-soft tracking-wide leading-relaxed">
  All-play is your record if you had played every team every week. Luck is real wins minus
  what those scores earned — negative means you deserved better.
</p>
