---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import StandingsTable from "../components/StandingsTable.astro";
import YardLine from "../components/YardLine.astro";
import StatPanel from "../components/StatPanel.astro";
import { seasons, latestFacts, weeksOf } from "../lib/data";
import { weekUrl } from "../lib/url";

const latest = latestFacts();
if (!latest) throw new Error("No fact packs found. Run: ffnews ingest && ffnews facts");

const published = (await getCollection("newsletters", (e) => e.data.status === "published"))
  .sort((a, b) => b.data.year - a.data.year || b.data.week - a.data.week);

const byYear = seasons.map((year) => ({
  year,
  // Numeric sort: week 10 comes after week 9, which the old site got wrong.
  weeks: weeksOf(year).map((week) => ({
    week,
    entry: published.find((e) => e.data.year === year && e.data.week === week),
  })),
}));

const leader = latest.standings[0];
---

<Base title="Pressbox — The Privacy Project" >
  <section class="relative overflow-hidden border-b hairline">
    <span
      class="jersey absolute -left-4 sm:-left-6 top-1/2 -translate-y-1/2 text-[13rem] sm:text-[19rem] pointer-events-none"
      aria-hidden="true">{String(latest.week).padStart(2, "0")}</span>

    <div class="relative mx-auto w-full max-w-6xl px-5 sm:px-8 py-14 sm:py-20">
      <p class="eyebrow mb-3">{latest.year} Season · Week {latest.week} of {latest.regularSeasonWeeks}</p>
      <h1 class="text-[2.75rem] sm:text-7xl max-w-3xl mb-5">
        Twelve managers.<br />One of them is<br /><span class="text-flag">{leader.name}</span>.
      </h1>
      <p class="prose-newsletter max-w-xl text-ink-soft mb-8">
        A weekly newsletter, written from the league's own game data and read by a human
        before it ships. Every number on this site comes from the same file the writing does.
      </p>
      <a
        href={weekUrl(latest.year, latest.week)}
        class="inline-flex items-center gap-2.5 board no-underline px-5 py-3 lift"
      >
        <span class="board-label !text-paper">Read week {latest.week}</span>
        <span class="text-flag font-mono">→</span>
      </a>
    </div>
  </section>

  <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
    <div class="grid gap-3 sm:grid-cols-3 -mt-7 relative z-10">
      <StatPanel index={0} label="High score, week" value={latest.highestTeam.score.toFixed(1)} sub={latest.highestTeam.name} />
      <StatPanel index={1} label="Low score, week" value={latest.lowestTeam.score.toFixed(1)} sub={latest.lowestTeam.name} />
      <StatPanel index={2} label="Season best" value={latest.seasonRecords.highestWeek.score.toFixed(1)}
        sub={`${latest.seasonRecords.highestWeek.name}, week ${latest.seasonRecords.highestWeek.week}`} />
    </div>

    <YardLine label={`Standings · through week ${latest.week}`} class="mt-14" />

    <StandingsTable rows={latest.standings} year={latest.year} playoffSpots={latest.playoffTeamCount} />

    <YardLine label="The archive" class="mt-16" />

    {byYear.map(({ year, weeks }) => (
      <section class="mb-12">
        <h2 class="text-3xl sm:text-4xl mb-5">{year}</h2>
        <ul class="grid gap-2 sm:grid-cols-2">
          {weeks.map(({ week, entry }, i) => (
            <li class="rise" style={`--i:${i}`}>
              <a
                href={weekUrl(year, week)}
                class="group flex items-baseline gap-4 border hairline bg-paper px-4 py-3.5 no-underline lift h-full"
              >
                <span class="font-display text-2xl text-ink/20 group-hover:text-flag transition-colors shrink-0 w-9">
                  {String(week).padStart(2, "0")}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block leading-snug">
                    {entry ? entry.data.title : `Week ${week}`}
                  </span>
                  {!entry && (
                    <span class="block eyebrow mt-1 !text-[0.625rem]">Stats only — no newsletter</span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
